# Resmara configuration. Copy to .env and fill in what you have - nothing here is
# required to boot: with no key the content engine runs in offline mode, and with no
# Meta token every platform call is simulated.
#
# Deploying this somewhere other than the build machine? See DEPLOY.md. The five values
# that MUST change for a real host are marked HOSTED below.

# --- core ---
# HOSTED: signs the logins. Generate with: openssl rand -hex 32
# SECRET_KEY=change-me-before-prod
# HOSTED: postgres in docker-compose is postgresql+psycopg://resmara:<pw>@db:5432/resmara
# Single-box sqlite instead: sqlite:////data/resmara.db
# DATABASE_URL=sqlite:///./resmara.db
# HOSTED: "production" for a real deployment.
RESMARA_ENV=development
# Where uploads are written. HOSTED: must be a persistent volume - Instagram fetches post
# media by public URL and this app has no object-storage backend.
UPLOAD_DIR=./uploads

# --- content engine ---
# Any OpenAI-compatible endpoint works. Unset RESMARA_ENGINE_BASE_URL to use OpenAI itself
# with OPENAI_API_KEY; point it at a self-hosted model (e.g. Ollama at
# http://127.0.0.1:11434/v1) to avoid API spend. A non-OpenAI endpoint has no /responses
# and no web search - the build notes then say the copy came from the supplied facts, not
# from live listing research.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# RESMARA_ENGINE_BASE_URL=http://127.0.0.1:11434/v1
# RESMARA_ENGINE_API_KEY=ollama
# Local models are slow: allow minutes per build. A reasoning model served this way must be
# asked for no thinking (the engine does that automatically for a local base).
# RESMARA_ENGINE_TIMEOUT=900
# RESMARA_ENGINE_MAX_TOKENS=8192
# RESMARA_ENGINE_NUM_CTX=32768
# Without a key the engine runs offline: the pipeline executes end to end but
# returns deterministic fixture copy and reports "source": "offline".
# Models per the handoff spec (docs 10-12): research + plan on the big model, brand and
# the design check on the mini model, designs via image edit. All five must name a model
# that the configured endpoint actually serves.
RESMARA_MODEL_RESEARCH=gpt-5.5
RESMARA_MODEL_PLAN=gpt-5.5
RESMARA_MODEL_BRAND=gpt-5.4-mini
RESMARA_MODEL_DESIGN=gpt-image-1
RESMARA_MODEL_CHECK=gpt-5.4-mini

# --- Meta / Graph ---
# Where the app is publicly reachable. Meta needs this for OAuth callbacks, and
# Instagram fetches post images by URL (there is no direct file upload for IG feed posts).
# HOSTED: the real https domain, no trailing slash.
RESMARA_PUBLIC_BASE_URL=https://sport.taila73942.ts.net/resmara
META_API_VERSION=v19.0
# Override only to point at a mock/test Graph host.
# GRAPH_API_BASE=http://127.0.0.1:9001/v19.0
# HOSTED: from the Meta app dashboard. Register META_REDIRECT_URI there too and list the
# host of RESMARA_PUBLIC_BASE_URL under App domains, or the consent redirect fails.
# META_CLIENT_ID=
# META_CLIENT_SECRET=
# META_REDIRECT_URI=https://app.example.com/api/oauth/meta/callback
# Meta rejects the whole consent dialog if any single scope is not enabled for the app's
# use cases, so keep this in step with what app review granted. Publishing needs
# pages_manage_posts + instagram_basic + instagram_content_publish.
# META_SCOPES=ads_management,business_management,pages_read_engagement,pages_show_list,pages_manage_posts,instagram_basic,instagram_content_publish
# Defaults used when an ad account row does not carry its own ids.
# META_PAGE_ID=
# META_IG_ID=

# --- secrets the app generates ---
# HOSTED: bearer for POST /api/content/publish/run (the publisher cron) and the
# X-Resmara-Token header for POST /api/oauth/meta/check-all (the token-health sweep).
# Generate with: openssl rand -base64 32
RESMARA_PUBLISH_TOKEN=
# HOSTED: Fernet key that encrypts connected Meta tokens at rest. Losing it means every
# connected ad account must be reconnected by hand - back it up with the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RESMARA_TOKEN_KEY=

# --- transactional email (password reset) ---
# Until this is set, a reset request answers delivery="not_configured" and returns the
# token so the flow can still be completed.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- other ad platforms ---
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- testing ---
# RESMARA_SIMULATE=1  # force offline engine + simulated platform calls
